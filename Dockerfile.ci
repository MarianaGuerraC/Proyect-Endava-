# Dockerfile.ci

FROM python:3.12-slim

# --------------------
# Crear usuario no-root
# --------------------
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# --------------------
# Instalar dependencias del sistema
# --------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential curl ca-certificates bash \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# --------------------
# Instalar pip y librerías principales
# --------------------
RUN pip install --upgrade pip && \
    pip install uv uvicorn fastapi pytest

COPY testing/requirements.txt ./testing/requirements.txt
RUN pip install -r testing/requirements.txt

# --------------------
# Copiar archivos del proyecto
# --------------------
COPY movie_shop_backend/pyproject.toml .
COPY movie_shop_backend/uv.lock .
COPY movie_shop_backend/src ./src
COPY movie_shop_backend/app_state.json .
COPY testing ./testing  

# --------------------
# Crear directorios de datos y reportes
# --------------------
RUN mkdir -p data reports && mv app_state.json data/

RUN mkdir -p /home/appuser/.cache/uv \
    && chown -R appuser:appuser /home/appuser/.cache
# --------------------
# Cambiar permisos y usar usuario no-root
# --------------------
# Directorio de cache para uv
ENV UV_CACHE_DIR=/home/appuser/.cache/uv
ENV XDG_CACHE_HOME=/home/appuser/.cache
RUN chown -R appuser:appuser /app
USER appuser

# --------------------
# Variables de entorno
# --------------------
ENV STATE_FILE=/app/data/app_state.json
ENV PYTHONUNBUFFERED=1

# --------------------
# Exponer puerto para la API
# --------------------
EXPOSE 8000

# --------------------
# CMD para correr la API
# --------------------
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
